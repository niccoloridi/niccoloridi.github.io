06","meeting":25,"doc":"annex","pdf":572,"printed":562,"texts":{"fr":"Le Secrétaire-Général communique cette liste à l'Assemblée et au Conseil.","en":"The Secretary-General shall submit this list to the Assembly and to the Council.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-article-8","weight":1.0,"end":79,"file":"all.p1.jsonl","lang":"en","line":4462,"start":0}]}]},{"meeting":32,"section":"32","passages":[{"seg_id":"s0684.09","meeting":32,"doc":"annex","pdf":684,"printed":674,"texts":{"fr":"L'Assemblée et le Conseil procèdent, indépendamment l'une de l'autre, à l'élection, d'abord des juges titulaires, ensuite des juges suppléants.","en":"The Assembly and the Council shall proceed to elect by independent voting first the judges and then the deputy-judges.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-article-8","weight":1.0,"end":90,"file":"all.p1.jsonl","lang":"en","line":5244,"start":0}]}]}],"histogram":[{"meeting":1,"count":0},{"meeting":2,"count":0},{"meeting":3,"count":0},{"meeting":4,"count":0},{"meeting":5,"count":0},{"meeting":6,"count":0},{"meeting":7,"count":0},{"meeting":8,"count":0},{"meeting":9,"count":0},{"meeting":10,"count":0},{"meeting":11,"count":0},{"meeting":12,"count":0},{"meeting":13,"count":0},{"meeting":14,"count":0},{"meeting":15,"count":0},{"meeting":16,"count":0},{"meeting":17,"count":0},{"meeting":18,"count":0},{"meeting":19,"count":0},{"meeting":20,"count":0},{"meeting":21,"count":0},{"meeting":22,"count":0},{"meeting":23,"count":0},{"meeting":24,"count":0},{"meeting":25,"count":2},{"meeting":26,"count":0},{"meeting":27,"count":0},{"meeting":28,"count":0},{"meeting":29,"count":0},{"meeting":30,"count":0},{"meeting":31,"count":0},{"meeting":32,"count":1},{"meeting":33,"count":0},{"meeting":34,"count":0},{"meeting":35,"count":0}],"members":[],"passage_count":3,"sources":["Edition"],"includes_descendants":false}