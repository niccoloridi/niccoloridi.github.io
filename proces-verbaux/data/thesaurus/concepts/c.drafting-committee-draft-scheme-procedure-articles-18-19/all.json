ed":591,"texts":{"fr":"M. DE LAPRADELLE soumet la nouvelle formule suivante:","en":"M. DE LAPRADELLE submitted the following wording:","full_text":""},"speaker":{"seg_id":"s0601.01","speaker_id":"lapradelle","certain":true,"name":"Albert de Geouffre de Lapradelle","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.02","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"„La Cour, avant d'y faire droit, doit s'assurer que ses conclusions, reposant sur des preuves sérieuses, sont fondées en fait et en droit.\"","en":"\"The Court must, before doing so, satisfy itself that the claim is supported by conclusive evidence and well-founded in fact and law.\"","full_text":""},"speaker":{"seg_id":"s0601.02","speaker_id":"lapradelle","certain":true,"name":"Albert de Geouffre de Lapradelle","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.03","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Le PRESIDENT veut ajouter à cette formule, entre les mots „sont\" et „fondées\", le mot „suffisamment\".","en":"The PRESIDENT wished to add the word \"sufficiently\" to the expression \"well-founded\". This proposal was rejected by a vote.","full_text":""},"speaker":{"seg_id":"s0601.03","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.04","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Cette proposition est mise aux voix et rejetée. La formule de M. de Lapradelle est adoptée.","en":"The Article was adopted with M. de Lapradelle's wording.","full_text":""},"speaker":{"seg_id":"s0601.04","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.05","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"M. RICCI-BUSATTI vote contre.","en":"M. RICCI-BUSATTI voted against it.","full_text":""},"speaker":{"seg_id":"s0601.05","speaker_id":"ricci-busatti","certain":true,"name":"Arturo Ricci-Busatti","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.06","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Article 16.","en":"Article 16.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.07","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Cet article est adopté avec des modifications de rédaction.","en":"This Article was adopted with amendments in wording.","full_text":""},"speaker":{"seg_id":"s0601.07","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.08","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Article 17.","en":"Article 17.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.09","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Cet article est adopté avec des modifications de rédaction.","en":"This Article was adopted with amendments in wording.","full_text":""},"speaker":{"seg_id":"s0601.09","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.10","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Article 18.","en":"Article 18.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.11","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Cet article est adopté sans discussion.","en":"This Article was adopted without discussion.","full_text":""},"speaker":{"seg_id":"s0601.11","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.12","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Article 19.","en":"Article 19.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.13","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Le PRESIDENT propose la formule suivante destinée à remplacer la dernière partie du premier alinéa: „Les dissidents ont la faculté de demander que leurs oppositions ou leurs réserves soient constatées.\"","en":"The PRESIDENT proposed the following wording, to replace the last part of the first Paragraph: \"Dissenting judges shall be entitled to have the fact of their dissent or reservations mentioned.\"","full_text":""},"speaker":{"seg_id":"s0601.13","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.14","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Sur la proposition de M. DE LAPRADELLE un vote préalable est pris sur les deux questions suivantes:","en":"On M. DE LAPRADELLE's proposal, a preliminary vote was taken upon the following questions:","full_text":""},"speaker":{"seg_id":"s0601.14","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.15","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"1. Le juge peut-il marquer son dissentiment sur le dispositif seulement? Le résultat du vote sur cette question est affirmatif.","en":"1. Should the judge have the right to record the fact of his dissent only? This question was decided in the affirmative.","full_text":""},"speaker":{"seg_id":"s0601.15","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.16","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"2. Le juge peut-il marquer son dissentiment sur les motifs? Le résultat du vote sur cette question est négatif.","en":"2. Should the judge be entitled to give his reasons for dissent? This question was decided in the negative.","full_text":""},"speaker":{"seg_id":"s0601.16","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.17","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Le PRESIDENT propose l'addition suivante: „sans pouvoir être motivées\" à la formule qu'il a soumise.","en":"The PRESIDENT proposed the following addition to the wording proposed by him: \"The reasons for dissent or reservations shall not be expressed.\"","full_text":""},"speaker":{"seg_id":"s0601.17","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.18","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Avec cette formule l'alinéa 1 de l'article 19 est adopté, malgré l'abstention de M. DE LAPRADELLE; celui-ci déclare que, n'ayant pas pu saisir la proposition, il doit s'abstenir.","en":"With this wording Paragraph 1 of Article 19 was adopted. M. DE LAPRADELLE abstained from voting, saying that, as he had not understood the proposal, he was bound to do so.","full_text":""},"speaker":{"seg_id":"s0601.18","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]},{"seg_id":"s0601.19","meeting":28,"doc":"minutes","pdf":601,"printed":591,"texts":{"fr":"Au sujet de l'alinéa 2, M. DE LAPRADELLE appuyé par M. Fernandes exprime le désir que l'on n'étende pas aux juges nationaux le droit de marquer leur dissentiment, afin de leur garantir une plus grande indépendance envers leur pays.","en":"In connection with Paragraph 2., M. DE LAPRADELLE, supported by M. Fernandes, wished to debar national judges from the right of recording their dissent; the object of this was to afford them a greater measure of independence with regard to their own country.","full_text":""},"speaker":{"seg_id":"s0601.19","speaker_id":"lapradelle","certain":true,"name":"Albert de Geouffre de Lapradelle","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[601]}]}]},{"meeting":30,"section":"30","passages":[{"seg_id":"s0651.01","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"M. DE LAPRADELLE soumet la formule suivante:"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.02","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"„La Cour, avant d'y faire droit, doit s'assurer que ces conclusions, reposant sur des preuves sérieuses, sont fondées en fait et en droit\"."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.03","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"LE PRESIDENT veut ajouter à cette formule entre les mots „sont\" et „fondées\" le mot „suffisamment\"."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.04","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Cette proposition, mise aux voix, est rejetée. La formule de M. de Lapradelle est adoptée."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.05","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Adopté."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.06","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Adopté (avec des modifications rédactionnelles). La dernière partie du second alinéa est formulée comme suit: „La voix du président ou de celui qui le remplace est prépondérante.\""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.07","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Adopté."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.08","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Adopté (avec modifications). Le président propose la formule suivante à remplacer la première partie du dernier alinéa:"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.09","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"„Les dissidents ont la faculté de demander que leurs oppositions ou leurs réserves soient constatées.\""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.10","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Sur la proposition de M. DE LAPRADELLE un vote préalable est pris sur les deux questions suivantes:"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.11","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"1. Le juge peut-il marquer son dissentiment sur le dispositif seulement?"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.12","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Cette question est répondue dans l'affirmative."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.13","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"2. Le juge peut-il marquer son dissentiment sur les motifs?"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.14","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Cette question est répondue dans la négative."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.15","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Le PRESIDENT lit de nouveau la formule qu'il a proposée avec une légère modification:"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.16","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"„Les dissidents ont la faculté de demander que leurs oppositions ou leurs réserves soient marquées\","},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.17","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Article 16."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.18","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Quand les agents, avocats et conseils ont fait valoir, sous le contrôle de la Cour, tous les moyens qu'ils jugent utiles, le Président prononce la clôture des débats."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.19","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"La Cour se retire en chambre du Conseil pour délibérer."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.20","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Les délibérations de la Cour sont et restent secrètes."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.21","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Article 17."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.22","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Les décisions de la Cour sont prises à la majorité des juges présents."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.23","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"En cas de partage de voix, la voix du Président ou de celui qui le remplace est prépondérante."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.24","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Article 18."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.25","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"L'arrêt est motivé. Il mentionne les noms des juges qui y ont pris part."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.26","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Article 19."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.27","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Si l'arrêt n'exprime pas, en tout ou en partie, l'opinion unanime des juges, les dissidents ont la faculté de demander l'insertion de leur opinion motivée, à la suite de l'exposé des motifs qui précède la décision de la majorité."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]},{"seg_id":"s0651.28","meeting":30,"doc":"annex","pdf":651,"printed":641,"texts":{"fr":"","en":"","full_text":"Cette faculté n'est pas ouverte aux juges de la nationalité des parties."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-articles-18-19","printed":"Index 1920","weight":0.3,"pages":[651]}]}]}],"histogram":[{"meeting":1,"count":0},{"meeting":2,"count":0},{"meeting":3,"count":0},{"meeting":4,"count":0},{"meeting":5,"count":0},{"meeting":6,"count":0},{"meeting":7,"count":0},{"meeting":8,"count":0},{"meeting":9,"count":0},{"meeting":10,"count":0},{"meeting":11,"count":0},{"meeting":12,"count":0},{"meeting":13,"count":0},{"meeting":14,"count":0},{"meeting":15,"count":0},{"meeting":16,"count":0},{"meeting":17,"count":0},{"meeting":18,"count":0},{"meeting":19,"count":0},{"meeting":20,"count":0},{"meeting":21,"count":0},{"meeting":22,"count":0},{"meeting":23,"count":0},{"meeting":24,"count":0},{"meeting":25,"count":0},{"meeting":26,"count":0},{"meeting":27,"count":0},{"meeting":28,"count":19},{"meeting":29,"count":0},{"meeting":30,"count":28},{"meeting":31,"count":0},{"meeting":32,"count":0},{"meeting":33,"count":0},{"meeting":34,"count":0},{"meeting":35,"count":0}],"members":[{"id":"descamps","name":"Baron Édouard Descamps","count":6},{"id":"lapradelle","name":"Albert de Geouffre de Lapradelle","count":3},{"id":"ricci-busatti","name":"Arturo Ricci-Busatti","count":1}],"passage_count":47,"sources":["Edition","Index 1920"],"includes_descendants":false}