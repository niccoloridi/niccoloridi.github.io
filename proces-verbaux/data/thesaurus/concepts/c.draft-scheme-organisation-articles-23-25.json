isation","range":[23,25]},"label_heading":"Avant-projet soumis par le Comité de rédaction","id":"fr.0027.21","lang":"fr","qualifier":null,"raw":"Arts. 23/25 — 575, 600/1, 613 (24bis), 614 (25), 619 (24), 625, 655 (24).","refs":[{"art_qual":null,"flags":[],"pdf":585,"printed":575,"raw":"575","seq":false},{"art_qual":null,"flags":[],"pdf":610,"printed":600,"raw":"600/1","seq":false},{"art_qual":null,"flags":[],"pdf":611,"printed":601,"raw":"600/1","seq":false},{"art_qual":"24bis","flags":[],"pdf":623,"printed":613,"raw":"613 (24bis)","seq":false},{"art_qual":"25","flags":[],"pdf":624,"printed":614,"raw":"614 (25)","seq":false},{"art_qual":"24","flags":[],"pdf":629,"printed":619,"raw":"619 (24)","seq":false},{"art_qual":null,"flags":[],"pdf":635,"printed":625,"raw":"625","seq":false},{"art_qual":"24","flags":[],"pdf":665,"printed":655,"raw":"655 (24)","seq":false}],"see":[],"source_pdf":776,"sub":"organisation: Arts. 23/25"},{"article_ref":{"art":"23","part":"organisation","range":[23,25]},"label_heading":"Draft scheme of the Committee","id":"en.0075.21","lang":"en","qualifier":null,"raw":"Arts. 23/25 — 575, 600/1, 613 (24bis), 614 (25), 619 (24), 625, 655 (24).","refs":[{"art_qual":null,"flags":[],"pdf":585,"printed":575,"raw":"575","seq":false},{"art_qual":null,"flags":[],"pdf":610,"printed":600,"raw":"600/1","seq":false},{"art_qual":null,"flags":[],"pdf":611,"printed":601,"raw":"600/1","seq":false},{"art_qual":"24bis","flags":[],"pdf":623,"printed":613,"raw":"613 (24bis)","seq":false},{"art_qual":"25","flags":[],"pdf":624,"printed":614,"raw":"614 (25)","seq":false},{"art_qual":"24","flags":[],"pdf":629,"printed":619,"raw":"619 (24)","seq":false},{"art_qual":null,"flags":[],"pdf":635,"printed":625,"raw":"625","seq":false},{"art_qual":"24","flags":[],"pdf":665,"printed":655,"raw":"655 (24)","seq":false}],"see":[],"source_pdf":783,"sub":"organisation: Arts. 23/25"}],"id":"t.avant-projet-soumis-par-le-comite-de-redaction.organisation-arts-23-25","label_en":"organisation: Arts. 23/25","label_fr":"organisation: Arts. 23/25","n_pages":8,"pages":[585,610,611,623,624,629,635,665],"parent":"t.avant-projet-soumis-par-le-comite-de-redaction","printed_en_id":"en.0075.21","printed_fr_id":"fr.0027.21","see":[],"type":"article"}],"groups":[{"meeting":32,"section":"32","passages":[{"seg_id":"s0687.06","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"La Cour tient une session chaque année.","en":"A session shall be held every year.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":39,"file":"all.p1.jsonl","lang":"fr","line":5323,"start":0}]},{"seg_id":"s0687.07","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Sauf disposition contraire du règlement d'ordre de la Cour, cette session commence le 15 juin, et continue tant que le rôle n'est pas épuisé.","en":"Unless otherwise provided by rules of Court this session shall begin on the 15th June, and shall continue for so long as may be necessary to complete the cases on the list.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":140,"file":"all.p1.jsonl","lang":"fr","line":5326,"start":60}]},{"seg_id":"s0687.08","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Le Président convoque la Cour en session extraordinaire quand les circonstances l'exigent.","en":"The President may summon an extraordinary meeting of the Court whenever necessary.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":55,"file":"all.p1.jsonl","lang":"fr","line":5329,"start":0}]},{"seg_id":"s0687.10","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Si, pour une raison spéciale, l'un des membres de la Cour estime ne pouvoir participer au jugement d'une affaire déterminée, il en fait part au Président.","en":"If, for some special reason, a member of the Court considers that he cannot take part in the decision of a particular case, he shall so inform the President.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":86,"file":"all.p1.jsonl","lang":"fr","line":5331,"start":0}]},{"seg_id":"s0687.11","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Si le Président estime qu'un des membres de la Cour ne peut siéger, pour une raison spéciale, dans une affaire déterminée, il en avertit le membre intéressé.","en":"If, for some special reason, the President considers that one of the members of the Court should not sit on a particular case, he shall give notice to the member concerned.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":156,"file":"all.p1.jsonl","lang":"fr","line":5333,"start":94}]},{"seg_id":"s0687.12","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Si l'un et l'autre ne sont pas d'accord dans chacun de ces cas sur l'attitude à prendre, la Cour décide.","en":"In the event of the President and the member not agreeing as to the course to be adopted in any such case, the matter shall be settled by the decision of the Court.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":103,"file":"all.p1.jsonl","lang":"fr","line":5335,"start":89}]},{"seg_id":"s0687.14","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Sauf exception expressément prévue, la Cour exerce ses attributions en séance plénière.","en":"The full Court shall sit except when it is expressly provided otherwise.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":86,"file":"all.p1.jsonl","lang":"fr","line":5337,"start":36}]},{"seg_id":"s0687.15","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Si la présence de 11 juges titulaires n'est pas assurée, ce nombre est parfait par l'entrée en fonction des juges suppléants.","en":"If 11 judges cannot be present, deputy-judges shall be called upon to sit, in order to make up this number.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":124,"file":"all.p1.jsonl","lang":"fr","line":5340,"start":57}]},{"seg_id":"s0687.16","meeting":32,"doc":"annex","pdf":687,"printed":677,"texts":{"fr":"Toutefois, si 11 juges ne sont pas disponibles, le quorum de 9 est suffisant pour constituer la Cour.","en":"If, however, 11 judges are not available, a quorum of 9 judges shall suffice to constitute the Court.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.draft-scheme-organisation-articles-23-25","weight":1.0,"end":100,"file":"all.p1.jsonl","lang":"fr","line":5342,"start":48}]}]}],"histogram":[{"meeting":1,"count":0},{"meeting":2,"count":0},{"meeting":3,"count":0},{"meeting":4,"count":0},{"meeting":5,"count":0},{"meeting":6,"count":0},{"meeting":7,"count":0},{"meeting":8,"count":0},{"meeting":9,"count":0},{"meeting":10,"count":0},{"meeting":11,"count":0},{"meeting":12,"count":0},{"meeting":13,"count":0},{"meeting":14,"count":0},{"meeting":15,"count":0},{"meeting":16,"count":0},{"meeting":17,"count":0},{"meeting":18,"count":0},{"meeting":19,"count":0},{"meeting":20,"count":0},{"meeting":21,"count":0},{"meeting":22,"count":0},{"meeting":23,"count":0},{"meeting":24,"count":0},{"meeting":25,"count":0},{"meeting":26,"count":0},{"meeting":27,"count":0},{"meeting":28,"count":0},{"meeting":29,"count":0},{"meeting":30,"count":0},{"meeting":31,"count":0},{"meeting":32,"count":9},{"meeting":33,"count":0},{"meeting":34,"count":0},{"meeting":35,"count":0}],"members":[],"passage_count":9,"sources":["Edition"],"includes_descendants":false}