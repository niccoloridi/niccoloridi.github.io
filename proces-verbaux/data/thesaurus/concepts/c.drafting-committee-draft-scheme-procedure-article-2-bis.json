 consiste en un acte effectué ou sur le point de l'être, la Cour a le pouvoir d'indiquer, si elle estime que les circonstances l'exigent, quelles mesures conservatoires du droit de chacun doivent être prises à titre provisoire.","en":"If the dispute arises out of an act which has already taken place or which is imminent, the Court shall have the power to suggest, if it considers that circumstances so require, the provisional measures that should be taken to preserve the respective rights of either party.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-article-2-bis","weight":1.0,"end":263,"file":"all.p1.jsonl","lang":"fr","line":4543,"start":174}]},{"seg_id":"s0578.02","meeting":25,"doc":"annex","pdf":578,"printed":568,"texts":{"fr":"En attendant son arrêt, cette suggestion de la Cour est immédiatement transmise aux parties et au Conseil.","en":"Pending the final decision, notice of the measures suggested shall forthwith be given to the parties and the Council.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-article-2-bis","weight":1.0,"end":106,"file":"all.p1.jsonl","lang":"fr","line":4546,"start":24}]}]},{"meeting":28,"section":"28","passages":[{"seg_id":"s0598.04","meeting":28,"doc":"minutes","pdf":598,"printed":588,"texts":{"fr":"Article 2 bis.","en":"Article 2 bis.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.drafting-committee-draft-scheme-procedure-article-2-bis","weight":1.0,"end":13,"file":"all.p1.jsonl","lang":"en","line":4751,"start":0}]}]}],"histogram":[{"meeting":1,"count":0},{"meeting":2,"count":0},{"meeting":3,"count":0},{"meeting":4,"count":0},{"meeting":5,"count":0},{"meeting":6,"count":0},{"meeting":7,"count":0},{"meeting":8,"count":0},{"meeting":9,"count":0},{"meeting":10,"count":0},{"meeting":11,"count":0},{"meeting":12,"count":0},{"meeting":13,"count":0},{"meeting":