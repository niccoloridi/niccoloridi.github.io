lang":"fr","qualifier":null,"raw":"Art. 9 — 556, 597.","refs":[{"art_qual":null,"flags":[],"pdf":566,"printed":556,"raw":"556","seq":false},{"art_qual":null,"flags":[],"pdf":607,"printed":597,"raw":"597","seq":false}],"see":[],"source_pdf":776,"sub":"organisation: Art. 9"},{"article_ref":{"art":"9","part":"organisation","range":null},"label_heading":"Draft scheme of the Committee","id":"en.0075.14","lang":"en","qualifier":null,"raw":"Art. 9 — 556, 597.","refs":[{"art_qual":null,"flags":[],"pdf":566,"printed":556,"raw":"556","seq":false},{"art_qual":null,"flags":[],"pdf":607,"printed":597,"raw":"597","seq":false}],"see":[],"source_pdf":782,"sub":"organisation: Art. 9"}],"id":"t.avant-projet-soumis-par-le-comite-de-redaction.organisation-art-9","label_en":"organisation: Art. 9","label_fr":"organisation: Art. 9","n_pages":2,"pages":[566,607],"parent":"t.avant-projet-soumis-par-le-comite-de-redaction","printed_en_id":"en.0075.14","printed_fr_id":"fr.0027.14","see":[],"type":"article"}],"groups":[{"meeting":25,"section":"25","passages":[{"seg_id":"s0566.01","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Le PRESIDENT déclare que l'alinéa 2 est également réservé.","en":"The PRESIDENT stated that Para. 2 would also be reserved.","full_text":""},"speaker":{"seg_id":"s0566.01","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.02","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Article 7.","en":"Article 7.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.03","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Sur la proposition de LORD PHILLIMORE, les membres du Comité conviennent de supprimer l'expression „à la majorité des voix.” L'expression „groupe national” doit être modifiée pour s'accorder avec la rédaction future de l'article 6, réservé.","en":"On LORD PHILLIMORE's proposal, the Committee agreed to delete the expression “by a majority of votes.” The phrase “national group” was to be modified to make it tally with the future wording of Article 6, which had been reserved.","full_text":""},"speaker":{"seg_id":"s0566.03","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.04","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"L'article est adopté; M. RICCI-BUSATTI s'abstient de voter.","en":"The Article was adopted; M. RICCI-BUSATTI abstained from voting.","full_text":""},"speaker":{"seg_id":"s0566.04","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.05","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Article 8.","en":"Article 8.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.06","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Mr. ROOT préfère la rédaction de l'article 7 du projet Root—Phillimore.","en":"Mr. ROOT preferred the wording of Article 7 of the Root—Phillimore plan.","full_text":""},"speaker":{"seg_id":"s0566.06","speaker_id":"root","certain":true,"name":"Elihu Root","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.07","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"M. RICCI-BUSATTI voudrait que la matière traitée dans cet article fût renvoyée au règlement de la Cour.","en":"M. RICCI-BUSATTI wished the subject dealt with in this Article to be left to the rules of Court.","full_text":""},"speaker":{"seg_id":"s0566.07","speaker_id":"ricci-busatti","certain":true,"name":"Arturo Ricci-Busatti","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.08","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Le PRESIDENT, appuyé par M. HAGERUP, fait valoir que le but de l'article est de caractériser le système, qui fait appel à trois organes, le Conseil, l'Assemblée et le corps présentateur.","en":"The PRESIDENT, supported by M. HAGERUP, pointed out that the object of this Article was to describe the system, in which three bodies took part: the Council, the Assembly and the nominating body.","full_text":""},"speaker":{"seg_id":"s0566.08","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.09","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Sur la proposition de M. HAGERUP, les membres du Comité conviennent d'ajouter au premier alinéa de l'article un renvoi à l'article 11, alinéa 2.","en":"On M. HAGERUP's proposal, the Committee agreed to add a reference to Article 11, Para. 2, to the first Paragraph of this Article.","full_text":""},"speaker":{"seg_id":"s0566.09","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.10","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"A cet égard, M. DE LAPRADELLE propose la rédaction suivante: „... éligibles sauf l'exception prévue à l'article 11, al. 2.”","en":"For this, M. DE LAPRADELLE proposed the following wording: “... eligible for appointment, except as provided in Article 11, para. 2.”","full_text":""},"speaker":{"seg_id":"s0566.10","speaker_id":"lapradelle","certain":true,"name":"Albert de Geouffre de Lapradelle","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.11","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"A la demande de Mr. ROOT, l'article est réservé.","en":"At Mr. ROOT's request this Article was reserved.","full_text":""},"speaker":{"seg_id":"s0566.11","speaker_id":"lapradelle","certain":true,"name":"Albert de Geouffre de Lapradelle","role":"member"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.12","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Article 9.","en":"Article 9.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.13","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Après une discussion sur la rédaction de l'alinéa 1er, on se met d'accord sur la rédaction suivante, proposée par M. de Lapradelle:","en":"After a discussion concerning the wording of the first Paragraph, the following wording, proposed by M. de Lapradelle, was adopted:","full_text":""},"speaker":{"seg_id":"s0566.13","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.14","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"„L'Assemblée et le Conseil procèdent, indépendamment l'une de l'autre, à l'élection d'abord des juges titulaires et ensuite des juges suppléants.”","en":"“The Assembly and the Council shall proceed to elect, by independent voting, first the judges and then the deputy judges.”","full_text":""},"speaker":{"seg_id":"s0566.14","speaker_id":null,"certain":false,"name":null,"role":null},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.15","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Cet alinéa formera un nouvel article 9; l'alinéa 2 est adopté comme article 9 bis.","en":"This Paragraph would form a new 9th Article; Paragraph 2 was adopted as Article 9 bis.","full_text":""},"speaker":{"seg_id":"s0566.15","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.16","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"L'alinéa 3 est adopté comme article 9 ter, 1er alinéa. L'alinéa 4 est adopté, avec des modifications de rédaction, comme article 9 ter, 2e alinéa.","en":"Paragraph 3 was adopted as Article 9 ter para. 1; the 4th paragraph, with an amended wording, as Article 9 ter para. 2.","full_text":""},"speaker":{"seg_id":"s0566.16","speaker_id":"collective","certain":false,"name":"The Committee (impersonal)","role":"collective"},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.17","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Article 10.","en":"Article 10.","full_text":""},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]},{"seg_id":"s0566.18","meeting":25,"doc":"minutes","pdf":566,"printed":556,"texts":{"fr":"Sur la proposition de LORD PHILLIMORE, le mot „élection” est substitué au mot „scrutin”. Lord Phillimore fait valoir que, puisqu'il y aura deux sortes de scrutins, le mot „scrutin” serait équivoque.","en":"At LORD PHILLIMORE's proposal the word “voting” (scrutin) was replaced by the word “election.” Lord Phillimore pointed out that, as there would be two kinds of votings (scrutin), the word might lead to misunderstanding.","full_text":""},"speaker":{"seg_id":"s0566.18","speaker_id":null,"certain":false,"name":null,"role":null},"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[566]}]}]},{"meeting":28,"section":"28","passages":[{"seg_id":"s0607.01","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"placée pour s'accorder avec la rédaction future de l'article 6, réservé."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.02","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Réservé."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.03","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Mr. ROOT préfère la rédaction de l'article 7 du projet Root-Phillimore."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.04","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"M. RICCI-BUSATTI voudrait renvoyer la matière traitée dans cet article au règlement de la Cour."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.05","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"On est d'accord, sur la proposition de M. HAGERUP, d'ajouter au premier alinéa de l'article un renvoi à l'article 11, alinéa 2."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.06","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"À cet égard, M. DE LAPRADELLE propose la rédaction suivante :"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.07","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"...éligible „sauf l'exception prévue à l'article 11, paragraphe 2”."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.08","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"L'alinéa 1 est adopté dans la rédaction suivante, proposée par M. DE LAPRADELLE :"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.09","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"„L'assemblée et le Conseil procèdent, indépendamment l'une de l'autre, à l'élection, d'abord des juges titulaires, ensuite des juges suppléants.”"},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.10","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Cet alinéa formera un nouvel article 9."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.11","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Alinéa 2 adopté comme article 9 bis."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.12","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Alinéa 3 adopté comme article 9 ter, 1er alinéa."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.13","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Alinéa 4 adopté avec des modifications de rédaction, comme article 9 ter, 2e alinéa."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.14","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Adopté."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.15","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Sur la proposition de LORD PHILLIMORE le mot „scrutin” est substitué par le mot „élection”."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.16","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Alinéa 1er réservé."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.17","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"M. ADATCI s'oppose à l'adoption dans l'alinéa d'un nombre limité d'élections."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.18","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"M. FERNANDES fait valoir que le Conseil et l'Assemblée n'auront pas à choisir dans une liste proposée par le comité de médiation, mais à adopter ou rejeter une proposition faite par le comité."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.19","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"d'Académie nationales ou internationales, vouées à l'étude du droit."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.20","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Article 8."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.21","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Article 9."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.22","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"L'Assemblée et le Conseil procèdent, indépendamment l'une de l'autre, à l'élection, d'abord des juges titulaires, ensuite des juges suppléants."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.23","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Article 9 bis."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.24","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Dans toute élection, les électeurs veillent à ce que les personnes appelées à faire partie de la Cour, non seulement réunissent individuellement les conditions requises, mais assurent dans l'ensemble la représentation des grandes formes de civilisation et des principaux systèmes juridiques du monde."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.25","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Article 9 ter."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.26","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Sont élus ceux qui ont réuni la majorité absolue des voix dans l'Assemblée et dans le Conseil."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.27","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Au cas où le double scrutin de l'Assemblée et du Conseil se porterait sur plus d'un membre de la même nationalité le plus âgé est seul élu."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.28","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Article 10."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.29","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Si après la première élection il reste encore des sièges à pourvoir, il est procédé de la même manière à une seconde élection, puis à une troisième."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.30","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Article 11."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]},{"seg_id":"s0607.31","meeting":28,"doc":"annex","pdf":607,"printed":597,"texts":{"fr":"","en":"","full_text":"Alinéa 2. Peuvent être portées sur cette liste, à l'unanimité, toutes personnes satisfaisant aux conditions requises, alors même qu'elles n'auraient pas figuré sur la liste de présentation de la Cour d'Arbitrage."},"speaker":null,"sources":["Index 1920"],"evidence":[{"concept":"c.draft-scheme-organisation-article-9","printed":"Index 1920","weight":0.3,"pages":[607]}]}]},{"meeting":32,"section":"32","passages":[{"seg_id":"s0684.11","meeting":32,"doc":"annex","pdf":684,"printed":674,"texts":{"fr":"Dans toute élection, les électeurs veillent à ce que les personnes appelées 