{"label_alt_en":["Protectorates"],"label_alt_fr":["Protectorat et Protégés"],"broader":[{"id":"facet.states","type":"theme","pref_fr":"États","pref_en":"States","is_facet":true},{"id":"facet.international","type":"theme","pref_fr":"Organisation internationale de la justice","pref_en":"International organisation of justice","is_facet":true}],"id":"c.protectorates-and-protected-states","issues":[],"pages":[588,589],"pref_en":"Protectorates and protected States","pref_fr":"Protectorats et États protégés","printed":["t.protectorat-et-proteges"],"related":[],"label_scope_note_en":"The Committee referred to protectorates and protected entities in considering the position of States in international justice.","type":"concept","direct_count":4,"propagated_count":4,"breadcrumb_paths":[[{"id":"facet.states","type":"theme","pref_fr":"États","pref_en":"States","is_facet":true},{"id":"c.protectorates-and-protected-states","type":"concept","pref_fr":"Protectorats et États protégés","pref_en":"Protectorates and protected States","is_facet":null}],[{"id":"facet.international","type":"theme","pref_fr":"Organisation internationale de la justice","pref_en":"International organisation of justice","is_facet":true},{"id":"c.protectorates-and-protected-states","type":"concept","pref_fr":"Protectorats et États protégés","pref_en":"Protectorates and protected States","is_facet":null}]],"narrower":[],"printed_entries":[{"entries":[{"article_ref":null,"label_heading":"Protectorat et Protégés","id":"fr.0163","lang":"fr","qualifier":null,"raw":"Protectorat et Protégés 578, 579.","refs":[{"art_qual":null,"flags":[],"pdf":588,"printed":578,"raw":"578","seq":false},{"art_qual":null,"flags":[],"pdf":589,"printed":579,"raw":"579","seq":false}],"see":[],"source_pdf":779,"sub":null},{"article_ref":null,"label_heading":"Protectorates","id":"en.0162","lang":"en","qualifier":null,"raw":"Protectorates 578, 579.","refs":[{"art_qual":null,"flags":[],"pdf":588,"printed":578,"raw":"578","seq":false},{"art_qual