printed":204,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":215,"printed":205,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":216,"printed":206,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":217,"printed":207,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":218,"printed":208,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":219,"printed":209,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":220,"printed":210,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":221,"printed":211,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":222,"printed":212,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":223,"printed":213,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":224,"printed":214,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":225,"printed":215,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":226,"printed":216,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":227,"printed":217,"raw":"204/17","seq":false},{"art_qual":null,"flags":[],"pdf":289,"printed":279,"raw":"279/80","seq":false},{"art_qual":null,"flags":[],"pdf":290,"printed":280,"raw":"279/80","seq":false},{"art_qual":null,"flags":[],"pdf":589,"printed":579,"raw":"579","seq":false},{"art_qual":null,"flags":[],"pdf":732,"printed":722,"raw":"722/3","seq":false},{"art_qual":null,"flags":[],"pdf":733,"printed":723,"raw":"722/3","seq":false}],"see":[],"source_pdf":784,"sub":"special"}],"id":"t.competence-de-la-cour.particulier","label_en":"special","label_fr":"particulier","n_pages":20,"pages":[211,214,215,216,217,218,219,220,221,222,223,224,225,226,227,289,290,589,732,733],"parent":"t.competence-de-la-cour","printed_en_id":"en.0106.02","printed_fr_id":"fr.0042.02","see":[],"type":"sub"}],"groups":[{"meeting":2,"section":"2","passages":[{"seg_id":"s0044.10","meeting":2,"doc":"annex","pdf":44,"printed":34,"texts":{"fr":"X. Les règles générales de la compétence de la Cour Permanente une fois fixées, la Cour devra-t-elle, en dehors de ces principes, avoir compétence pour connaître de litiges définis spécialement, par exemple, dans le Traité de Paix?","en":"X. The general rules of competency of the Permanent Court once having been laid down, shall the Court, apart, from such principles, be competent in specially determined cases resulting, for instance, from the Peace Treaty.","full_text":""},"speaker":null,"sources":["Edition"],"evidence":[{"concept":"c.special-jurisdiction-of-the-court","weight":1.0,"end":193,"file":"all.p1.jsonl","lang":"fr","line":269,"start":102}]}]},{"meeting":9,"section":"9","passages":[{"seg_id":"s0215.08","meeting":9,"doc":"minutes","pdf":215,"printed":205,"texts":{"fr":"…e de privilège de souveraineté admis par la législation et la jurisprudence de certains pays, comme la France. M. de Lapradelle pose la question de savoir si, dans des circonstances semblables, il ne serait pas utile de donner à la Cour de Justice Internationale une compétence accessoire: la Cour agirait alors sur l'initiative d'un particulier, pourvu que le cas n'ait pas de caractère politique.","en":"The Court of which the creation was under consideration was essentially a tribunal to deal with disputes between States. However, it might be considered whether the right to have recourse to the Court should not be given to some extent to private individuals, that is to say, in cases of denial of…","full_text":""},"speaker":{"seg_id":"s0215.08","speaker_id":"lapradelle","certain":true,"name":"Albert de Geouffre de Lapradelle","role":"member"},"sources":["Edition"],"evidence":[{"concept":"c.special-jurisdiction-of-the-court","weight":1.0,"end":289,"file":"all.p1.jsonl","lang":"fr","line":1338,"start":221}]}]},{"meeting":11,"section":"11","passages":[{"seg_id":"s0249.02","meeting":11,"doc":"minutes","pdf":249,"printed":239,"texts":{"fr":"Le PRESIDENT répète que, d'une façon générale, il ne voit pas d'inconvénient à ce qu'on introduise une disposition dans le sens proposé par M. Hagerup. Il fait observer que la Convention de 1907 s'est déjà engagée dans cette voie, en stipulant la compétence de la Cour Permanente d'Arbitrage dans…","en":"… effect suggested by M. Hagerup. He pointed out that the Convention of 1907 had already proceeded along these lines by laying down that the Permanent Court of Arbitration should be competent to deal with all cases which the parties concerned had not agreed to submit to a special jurisdiction.","full_text":""},"speaker":{"seg_id":"s0249.02","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Edition"],"evidence":[{"concept":"c.special-jurisdiction-of-the-court","weight":1.0,"end":293,"file":"all.p1.jsonl","lang":"en","line":1684,"start":221}]}]},{"meeting":23,"section":"23","passages":[{"seg_id":"s0521.06","meeting":23,"doc":"minutes","pdf":521,"printed":511,"texts":{"fr":"Lord Phillimore croit que la solution proposée en ce qui concerne la Haute Cour, est „trop mince\". Bien que le projet du Président renferme des règles fondamentales concernant l'organisation de la Haute Cour, sa compétence propre, son mode de mise en mouvement, son pouvoir de caractériser le délit,…","en":"Lord Phillimore appeared to think that the proposed plan for the High Court was too indefinite. Although his plan included fundamental rules governing the organisation of the High Court, its special jurisdiction, the method of setting the procedure in motion, its powers of defining the offences, of fixing the penalty, and of providing as far as possible for the execution of the sentences —although his plan included all this—the President was the first to acknowledge that his work was open to improvement and could be made more complete. Nevertheless he considered th…","full_text":""},"speaker":{"seg_id":"s0521.06","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Edition"],"evidence":[{"concept":"c.special-jurisdiction-of-the-court","weight":1.0,"end":211,"file":"all.p1.jsonl","lang":"en","line":4055,"start":187}]}]}],"histogram":[{"meeting":1,"count":0},{"meeting":2,"count":1},{"meeting":3,"count":0},{"meeting":4,"count":0},{"meeting":5,"count":0},{"meeting":6,"count":0},{"meeting":7,"count":0},{"meeting":8,"count":0},{"meeting":9,"count":1},{"meeting":10,"count":0},{"meeting":11,"count":1},{"meeting":12,"count":0},{"meeting":13,"count":0},{"meeting":14,"count":0},{"meeting":15,"count":0},{"meeting":16,"count":0},{"meeting":17,"count":0},{"meeting":18,"count":0},{"meeting":19,"count":0},{"meeting":20,"count":0},{"meeting":21,"count":0},{"meeting":22,"count":0},{"meeting":23,"count":1},{"meeting":24,"count":0},{"meeting":25,"count":0},{"meeting":26,"count":0},{"meeting":27,"count":0},{"meeting":28,"count":0},{"meeting":29,"count":0},{"meeting":30,"count":0},{"meeting":31,"count":0},{"meeting":32,"count":0},{"meeting":33,"count":0},{"meeting":34,"count":0},{"meeting":35,"count":0}],"members":[{"id":"descamps","name":"Baron Édouard Descamps","count":2},{"id":"lapradelle","name":"Albert de Geouffre de Lapradelle","count":1}],"passage_count":4,"sources":["Edition"],"includes_descendants":false}