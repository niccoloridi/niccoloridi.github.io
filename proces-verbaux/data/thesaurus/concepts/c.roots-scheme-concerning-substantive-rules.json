],"narrower":[],"printed_entries":[{"entries":[{"article_ref":null,"label_heading":"Root, Mr. Elihu","id":"fr.0167.02","lang":"fr","qualifier":null,"raw":"Root, Mr. Elihu. Lettre au Président du Comité national républicain 18; projet concernant les normes matérielles 331, 344 (texte); première proposition concernant l'élection des juges 150, 160, 166 (texte), 182, 356, 378; projet de résolution 23 seq., 41 (texte); proposition de vote concernant l'élection des juges 355, 378 (texte).","refs":[{"art_qual":null,"flags":[],"pdf":341,"printed":331,"raw":"331","seq":false},{"art_qual":null,"flags":["texte"],"pdf":354,"printed":344,"raw":"344 (texte)","seq":false}],"see":[],"source_pdf":779,"sub":"projet concernant les normes matérielles"},{"article_ref":null,"label_heading":"Root, Mr. Elihu","id":"en.0186.02","lang":"en","qualifier":null,"raw":"Root, Mr. Elihu. Letter to the President of the National Republican Committee 18; scheme re substantive rules 331, 344 (text); first proposal on election of judges 150, 160, 166 (text), 182, 356, 378; draft resolution 23 seq., 41 (text).","refs":[{"art_qual":null,"flags":[],"pdf":341,"printed":331,"raw":"331","seq":false},{"art_qual":null,"flags":["texte"],"pdf":354,"printed":344,"raw":"344 (text)","seq":false}],"see":[],"source_pdf":785,"sub":"scheme re substantive rules"}],"id":"t.root-mr-elihu.projet-concernant-les-normes-materielles","label_en":"scheme re substantive rules","label_fr":"projet concernant les normes matérielles","n_pages":2,"pages":[341,354],"parent":"t.root-mr-elihu","printed_en_id":"en.0186.02","printed_fr_id":"fr.0167.02","see":[],"type":"sub"}],"groups":[{"meeting":15,"section":"15","passages":[{"seg_id":"s0341.06","meeting":15,"doc":"minutes","pdf":341,"printed":331,"texts":{"fr":"Mr. ROOT rappelle que M. Hagerup lui a demandé la veille de formuler ses idées à ce sujet. Il présente au Président un texte qu'il a préparé en collaboration avec Lord Phillimore.","en":"Mr. ROOT recalled that M. Hagerup had asked him on the previous day to put his ideas on the subject in writing. He presented a draft to the President which he had prepared in collaboration with Lord Phillimore.","full_text":""},"speaker":{"seg_id":"s0341.06","speaker_id":"root","certain":true,"name":"Elihu Root","role":"member"},"sources":["Edition"],"evidence":[{"concept":"c.roots-scheme-concerning-substantive-rules","weight":1.0,"end":110,"file":"all.p1.jsonl","lang":"en","line":2514,"start":71}]},{"seg_id":"s0341.07","meeting":15,"doc":"minutes","pdf":341,"printed":331,"texts":{"fr":"Le PRESIDENT donne lecture de ce texte (voir annexe 1). Il déclare qu'il s'y rallie sous réserve d'une modification au No. 4 dans lequel il voudrait que les mots „doctrines concordantes” fussent substitués aux mots: „les opinions”.","en":"The PRESIDENT read the draft. (See annex 1). He declared that he agreed with it, except that in Number 4 he wished to substitute for the words \"the opinions\" the words \"coinciding doctrines\".","full_text":""},"speaker":{"seg_id":"s0341.07","speaker_id":"descamps","certain":true,"name":"Baron Édouard Descamps","role":"member"},"sources":["Edition"],"evidence":[{"concept":"c.roots-scheme-concerning-substantive-rules","weight":1.0,"end":104,"file":"all.p1.jsonl","lang":"en","line":2515,"start":45}]}]}],"histogram":[{"meeting":1,"count":0},{"meeting":2,"count":0},{"meeting":3,"count":0},{"meeting":4,"count":0},{"meeting":5,"count":0},{"meeting":6,"count":0},{"meeting":7,"count":0},{"meeting":8,"count":0},{"meeting":9,"count":0},{"meeting":10,"count":0},{"meeting":11,"count":0},{"meeting":12,"count":0},{"meeting":13,"count":0},{"meeting":14,"count":0},{"meeting":15,"count":2},{"meeting":16,"count":0},{"meeting":17,"count":0},{"meeting":18,"count":0},{"meeting":19,"count":0},{"meeting":20,"count":0},{"meeting":21,"count":0},{"meeting":22,"count":0},{"meeting":23,"count":0},{"meeting":24,"count":0},{"meeting":25,"count":0},{"meeting":26,"count":0},{"meeting":27,"count":0},{"meeting":28,"count":